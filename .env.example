# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
JARVIS_MODEL=claude-opus-5-5
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORD=jarvis
# Set to "true" to start the terminal assistant in voice mode (requires mic + speakers)
JARVIS_VOICE=false
# Default reasoning effort: low | medium | high | xhigh | max. Deep protocols use "high".
# Leave empty if you switch to a model that doesn't support effort (e.g. Haiku).
JARVIS_EFFORT=medium
# Claude's built-in web search (billed per search by Anthropic)
JARVIS_WEB_SEARCH=true
# Retry on a fallback model server-side if a request is declined by safety classifiers
JARVIS_FALLBACKS=true
# Where notes, reminders and the project workspace are stored (default ~/.jarvis)
# JARVIS_DATA_DIR=

# Optional: enables the get_weather tool (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
