# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional overrides
JARVIS_MODEL=claude-sonnet-5
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORD=jarvis
# Set to "true" to start in voice mode by default (requires mic + speakers)
JARVIS_VOICE=false

# Optional: enables the get_weather tool (https://openweathermap.org/api)
OPENWEATHER_API_KEY=
